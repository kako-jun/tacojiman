{
  "name": "tacojiman",
  "version": "0.1.0",
  "description": "朝の蛸島駅で繰り広げられる3分間の忍術バトルゲーム",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" README.md CLAUDE.md .claude/tasks.md \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" README.md CLAUDE.md .claude/tasks.md \"docs/**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "game",
    "pixijs",
    "typescript",
    "pixel-art",
    "action",
    "mobile",
    "noto-peninsula"
  ],
  "author": "kako-jun",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "pixi.js": "^8.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kako-jun/tacojiman.git"
  },
  "homepage": "https://kako-jun.github.io/tacojiman",
  "bugs": {
    "url": "https://github.com/kako-jun/tacojiman/issues"
  }
}
